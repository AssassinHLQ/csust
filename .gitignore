# ---- Godot 引擎缓存与产物（官方模板）----
.godot/
/android/
*.translation

# ---- 私有素材：版权不属于本项目，不随仓库分发 ----
# 理由见 THIRD_PARTY.md
#
# 角色模型与自动解包的贴图（Blue Archive © NEXON Games / Yostar）
/models/*.glb
/models/*.glb.import
/models/Arisu*.png
/models/Arisu*.png.import
# 校园高斯泼溅扫描与派生碰撞网格（权利状态未核实）
/splatdata/*.sogdata
/splatdata/*.sog
# ⚠️ .sog 一旦躺在 res:// 里，gdgs 插件就会把它烘焙成 2 GB 级的 .res
#    （2026-10-21 实测 70.8 MB 的 .sog → 2.47 GB），连带 .import 一起别进仓库
/splatdata/*.import
/splatdata/*.sog.import
/models/school*.glb
/models/school*.glb.import
# Boss 模型（霸王龙优香，同样派生自 Blue Archive）
/models/boss/**
# 第二名 Boss：飞猪优香（FBX + 贴图 + 作者的对照渲染图）
/models/boss_pig/**
/models/boss_squash/**
# 第四、第五名 Boss：霍德 / 佩洛洛斯拉（FBX + 贴图，作者：一个睿智）
/models/boss_hod/**
/models/boss_perorozilla/**
# 第六、第七名 Boss：比纳 / 哥利亚（备用库，作者：一个睿智）
/models/boss_binah/**
/models/boss_goliath/**
# 同伴模型（小雪 / 优香 / 诺亚，同样派生自 Blue Archive）
/models/companions/**
# 老师 NPC（MMD 模型，作者：食小派蒙辣）—— 同属第三方素材，不随仓库分发
/models/npc/**
/models/npc/serika/
/models/npc/sora/

# Sprout Lands UI 素材（美术：Cup Nooble）—— 授权原文写着
# 「You can not redistribute or resale, even if modified.」，
# 所以**不能**随仓库分发。本地放进 assets/ui_sprout/ 就会自动启用（否则回退 assets/ui/）。
/assets/ui_sprout/**

# 背景音乐（现在放的是 UNDERTALE「Tem Shop」，© Toby Fox / Materia Collective）
# —— 专有版权，**不随仓库分发**。本地把 `assets/music/shop_theme.ogg` 放好即可，
# 没有它时商店只是没有 BGM，不会报错（`scripts/music.gd` 会 push_warning 一次）。
# ⚠️ 只排除音频本体，**保留 `shop_theme.ogg.import`** ——
#    循环开关（`loop=true`）存在那个文件里，克隆者把音频放进来就直接是循环的。
/assets/music/*.ogg
/assets/music/*.wav
!/assets/music/*.ogg.import
!/assets/music/README.md

# 界面显示字体（现在放的是 Aa 字库的「Aa暗夜深渊」，商用需授权）——
# 同样**不随仓库分发**。本地丢进 assets/ui_font/ 就自动启用，
# 没有它时回退 assets/ui/font.ttf（Fusion Pixel，OFL，可分发）。
# 见 assets/ui_font/README.md 与 THIRD_PARTY.md。
/assets/ui_font/**
!/assets/ui_font/README.md

# 但保留两个目录下的说明文件，克隆者要靠它们知道该放什么
!/models/README.md
!/splatdata/README.md

# ---- 本地产物 ----
*.log
*.tmp
_export_out*.log
_import_out*.log
_selftest_out*.log
_probe_out*.log

# Python 工具的字节码缓存（`tools/font/font_needed.py` 会 import 同目录的模块）
__pycache__/
*.pyc

# ---- 如果你自己加了原创模型/场景，想让它进仓库，
#      就把上面 /models/*.glb 那几行改成显式排除 ----

# ---- Aholo CLI（tools/aholo）----
# 依赖与临时产物不进仓库；密钥只走环境变量 AHOLO_API_KEY
/tools/aholo/node_modules/
/tools/aholo/out/
/tools/aholo/_probe.png

# RTX 5090 模型：爱给网下载，仅限本地学习使用（不可再分发）
/models/rtx5090/

# 三星 970 EVO Plus M.2 固态：爱给网下载（作者未署名），仅限本地学习演示，不随仓库分发。
# 缺这个文件时 `_build_pc_wall_case.gd` 会 push_warning 并跳过机箱里那 2 颗硬盘，
# 机箱本身照常生成 —— 和 /models/gamedev_room/ 一个套路。见 CREDITS.md。
/models/ssd_970evo/

# 电竞房素材的中间产物：从 3d66 大杂烩里抽出来的簇、平滑候选模型。
# 都是临时文件、随时可重生成；3d66 / CGAxis 是商业素材站，绝不能进仓库。
# 爱给网「现代网咖·电竞酒店套房·宿舍上下铺」——商业素材站（aigei.com），
# 与 3d66 / CGAxis 同类，**绝不能进仓库**。优化管线见 _tools/opt_archviz.py。
/models/_wip_esports_hotel/
/models/_wip_hotel/
/models/_wip_room/

# 游戏开发部部室（Sketchfab 作者：起航扬帆了）—— 下载包无许可文件、原页面 404，
# 授权未核实，只允许本地学习演示，不随仓库分发。见 credits.gd 与 CREDITS.md
/models/gamedev_room/

# SpaceX Falcon 9（Sketchfab 作者：Forest Katsch，CC BY-NC 4.0）—— 带 NC（禁商用）条款，
# 按「第三方素材一律不进仓库」的既有口径排除。缺这个文件时 `rocket_ride.gd` 会
# 自动换成**程序化占位火箭**，跑酷的去程/回程照常能飞完 —— 和 gamedev_room /
# pc_wall_case 一个套路。要恢复真模型：见 CREDITS.md 里那条的还原步骤。
/models/rocket_falcon9/

# 电竞房 LOD 的**高模 / 中模**（2026-11-08）—— 334 MB 的派生档，不进仓库。
#
#     esports_room_high.glb  233.9 MB  减面前原始档，757 万面（0 ~ 12 m 用）
#     esports_room_mid.glb   100.6 MB  ~280 万面（12 ~ 30 m 用）
#     esports_room.glb        47  MB   105 万面（30 m+ 用）——**这一档已入库**，够跑
#
# 缺档不影响启动：`scripts/esports_lod.gd` 的规矩是「缺哪一档就退到下一档」
# （high 缺 → 用 mid，mid 也缺 → 用当前的低模），所以别人克隆下来只是
# 近处看不到 757 万面那版，画面照常。
#
# 要复现完整 LOD：本地用 `tools/build_esports_room.py` 从源 FBX 重新减面导出
# 到这几个文件名即可（`.import` 会让 Godot 自动重建）。
# 贴图一并排除 —— 它们是从低模那套同名贴图复制出来的，低模那份已入库。
/models/esports_room/esports_room_high.glb
/models/esports_room/esports_room_high.glb.import
/models/esports_room/esports_room_high_*.jpg
/models/esports_room/esports_room_high_*.jpg.import
/models/esports_room/esports_room_high_*.png
/models/esports_room/esports_room_high_*.png.import
/models/esports_room/esports_room_mid.glb
/models/esports_room/esports_room_mid.glb.import
/models/esports_room/esports_room_mid_*.jpg
/models/esports_room/esports_room_mid_*.jpg.import
/models/esports_room/esports_room_mid_*.png
/models/esports_room/esports_room_mid_*.png.import

# 校园分块（离线切成 3×3，用 scripts/_split_sog.gd 重新生成）
/splatdata/campus_chunks/

# ---- GGS 校园的 packed bin（1.4 GB，导出时才需要；不进仓库）----
/campus_ggs.bin
# 粗层：全校园按每 4 点留 1 抽稀（352 MB / 154 万点），
# 由 `_tools/decimate_ggs_bin.py campus_ggs.bin campus_ggs_q4.bin 4` 生成
/campus_ggs_q4.bin

# ---- 配置单悬停用的零件照片 ----
# 8 张都是第三方新闻/商品图，**未获授权**：只允许本地学习演示，不得再分发、不得商用。
# 逐张出处见 assets/story/parts/SOURCES.md；缺图时配置单照常显示，只是悬停不换图。
/assets/story/parts/*.png
/assets/story/parts/*.png.import
!/assets/story/parts/SOURCES.md
# 游戏开发部活动室截图（Blue Archive 游戏内画面，仅本地学习，不随仓库分发）
/assets/story/gamedev_room.jpg
/assets/story/gamedev_room.jpg.import


# ---- 导出产物 ----
/build/

