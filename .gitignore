#    想给别人跑：让对方自己用 tools/gen_kei_voice.py 生成。
/story/voice/kei/

# 校园 10×10 分块（离线用 scripts/_split_sog.gd + _export_campus_ggs_bins10.gd 重新生成）
# ⚠️ 这一套的尺度是错的（只有全量的 1/3），只留作对照，运行时默认用 campus_chunks10w。
/splatdata/campus_chunks10/*
!/splatdata/campus_chunks10/chunks.json

# 校园 10×10 分块（**世界坐标**那套，2026-11-05 起是默认）
# 重新生成：python _tools/split_ggs_bin.py campus_ggs.bin splatdata/campus_chunks10w 10 10
/splatdata/campus_chunks10w/*
!/splatdata/campus_chunks10w/chunks.json

# ---- 工作草稿目录：`_` 前缀 = 临时，一律不入库 ----
# 2026-11-07 清点：这四个目录合计 352 个未跟踪文件、约 1.8 GB，从来不是源码，
# 却因为没有 ignore 规则而长期挂在 `git status` 里，把真正的改动淹掉了。
#   _log/             探针日志 + 抓图 + 体素 bin（campus_vox30.bin 单个就 982 MB）
#   _arisu_captures/  截图产物
#   _sky_upscale/     超分试验输出（Real-ESRGAN 的 _trial_* / _q*_ss* 等）
#   _backup/          手写 .bak 备份（有 git 之后不该再手写备份，提交历史就是备份）
/_log/
/_arisu_captures/
/_sky_upscale/
/_backup/

# ---- 校园分块 SOG（2026-11-11）----
# 由 `scripts/_split_sog.gd --nx=10 --nz=10 --shared-centroids ...` 从
# splatdata/school_playable.sogdata 生成；是第三方的派生物，不入库。
# 只留两个小清单：chunks.json（运行时读）和 frame.json（相似变换）。
# 重新生成：
#   & <godot> --headless --path . --script res://scripts/_split_sog.gd -- --input=res://splatdata/school_playable.sogdata --nx=14 --nz=14 --write --out-dir=res://splatdata/campus_sog/fine --scene=res://_log/campus_sog_fine.tscn --shared-centroids=res://splatdata/campus_sog/shn_centroids.webp
#   （⚠️ 重新切之前先删掉整个 fine/ 目录：格子数一变，某些格子会变空、
#     旧文件不会被覆盖，残留会把总点数顶多）
#   & <godot> --headless --path . --script res://scripts/_split_sog.gd -- --input=res://splatdata/school_playable.sogdata --nx=1 --nz=1 --stride=4 --write --out-dir=res://splatdata/campus_sog/coarse --scene=res://_log/campus_sog_coarse.tscn --shared-centroids=res://splatdata/campus_sog/shn_centroids.webp
#   python tools/fit_campus_frame.py
#   python tools/make_campus_sog_manifest.py
/splatdata/campus_sog/*
!/splatdata/campus_sog/chunks.json
!/splatdata/campus_sog/frame.json
