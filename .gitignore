# ---- Godot 引擎缓存与产物（官方模板）----
.godot/
/android/
*.translation

# ---- 私有素材：版权不属于本项目，不随仓库分发 ----
# 理由见 THIRD_PARTY.md
#
# 角色模型与自动解包的贴图（Blue Archive © NEXON Games / Yostar）
/models/*.glb
/models/*.glb.import
/models/Arisu*.png
/models/Arisu*.png.import
# 校园高斯泼溅扫描与派生碰撞网格（权利状态未核实）
/splatdata/*.sogdata
/splatdata/*.sog
# ⚠️ .sog 一旦躺在 res:// 里，gdgs 插件就会把它烘焙成 2 GB 级的 .res
#    （2026-10-21 实测 70.8 MB 的 .sog → 2.47 GB），连带 .import 一起别进仓库
/splatdata/*.import
/splatdata/*.sog.import
/models/school*.glb
/models/school*.glb.import
# Boss 模型（霸王龙优香，同样派生自 Blue Archive）
/models/boss/**
# 第二名 Boss：飞猪优香（FBX + 贴图 + 作者的对照渲染图）
/models/boss_pig/**
/models/boss_squash/**
# 第四、第五名 Boss：霍德 / 佩洛洛斯拉（FBX + 贴图，作者：一个睿智）
/models/boss_hod/**
/models/boss_perorozilla/**
# 第六、第七名 Boss：比纳 / 哥利亚（备用库，作者：一个睿智）
/models/boss_binah/**
/models/boss_goliath/**
# 同伴模型（小雪 / 优香 / 诺亚，同样派生自 Blue Archive）
/models/companions/**
# 老师 NPC（MMD 模型，作者：食小派蒙辣）—— 同属第三方素材，不随仓库分发
/models/npc/**
/models/npc/serika/
/models/npc/sora/

# Sprout Lands UI 素材（美术：Cup Nooble）—— 授权原文写着
# 「You can not redistribute or resale, even if modified.」，
# 所以**不能**随仓库分发。本地放进 assets/ui_sprout/ 就会自动启用（否则回退 assets/ui/）。
/assets/ui_sprout/**

# 背景音乐（现在放的是 UNDERTALE「Tem Shop」，© Toby Fox / Materia Collective）
# —— 专有版权，**不随仓库分发**。本地把 `assets/music/shop_theme.ogg` 放好即可，
# 没有它时商店只是没有 BGM，不会报错（`scripts/music.gd` 会 push_warning 一次）。
# ⚠️ 只排除音频本体，**保留 `shop_theme.ogg.import`** ——
#    循环开关（`loop=true`）存在那个文件里，克隆者把音频放进来就直接是循环的。
/assets/music/*.ogg
/assets/music/*.wav
!/assets/music/*.ogg.import
!/assets/music/README.md

# 开场 PV 素材（2026-11-12）—— 和上面 BGM / 模型同一条规矩：
#   · 图片里混有 Blue Archive 游戏内画面（© NEXON Games / Yostar）与本地截图；
#   · PV 音乐是 BA OST「Constant Moderato（PV1）」。
#   **都不随仓库分发**。缺素材时 `scripts/title_intro.gd` 会自动退回
#   「渐变深蓝底 + 标题」，启动、进度条、开始按钮照常，只是没有 PV 画面/音乐。
# 想自己换图：把 png 丢进 assets/cg/pv/（按文件名排序），见那个目录的 README.md。
# ⚠️ `.import` 也一起排除：源图不在时留着 .import 会让 Godot 一直报
#    「找不到源文件」，而且克隆者放新图时会沿用旧的导入参数。
/assets/cg/pv/*.png
/assets/cg/pv/*.png.import
/assets/cg/pv/*.jpg
/assets/cg/pv/*.jpg.import
/assets/cg/pv/*.jpeg
/assets/cg/pv/*.jpeg.import
/assets/cg/pv/*.webp
/assets/cg/pv/*.webp.import
!/assets/cg/pv/README.md
# AI 超分（Real-ESRGAN 4× → 高 1440）后的同名图：同样只是本地产物，
# 由 `_tools/upscale_pv_images.ps1` 从上面的原图重新生成，不入库。
/assets/cg/pv_hd/*.png
/assets/cg/pv_hd/*.png.import
/assets/cg/pv_hd/*.jpg
/assets/cg/pv_hd/*.jpg.import
/assets/cg/pv_hd/*.jpeg
/assets/cg/pv_hd/*.jpeg.import
/assets/cg/pv_hd/*.webp
/assets/cg/pv_hd/*.webp.import
/assets/music/pv_theme.mp3
/assets/music/pv_theme.mp3.import

# 爱丽丝轨道炮音效（Blue Archive 游戏内音频，© NEXON Games / Yostar）
# —— 专有版权，**不随仓库分发**，与上面 BGM、`models/Arisu*.glb` 同一套处理方式。
# 由 `_godot_editor_data/make_aris_sfx.py` 从本地 SFX 包里裁出；
# 没有这批文件时开枪/换弹只是没声音，游戏照常跑（`scripts/sfx.gd` 会 push_warning 一次）。
# ⚠️ 保留 `*.wav.import`：导入参数在里面，克隆者把裁好的 wav 放进来就直接能用。
# 见 `assets/sfx/aris/README.md`。
/assets/sfx/aris/*.wav
!/assets/sfx/aris/*.wav.import
!/assets/sfx/aris/README.md

# 界面显示字体（现在放的是 Aa 字库的「Aa暗夜深渊」，商用需授权）——
# 同样**不随仓库分发**。本地丢进 assets/ui_font/ 就自动启用，
# 没有它时回退 assets/ui/font.ttf（Fusion Pixel，OFL，可分发）。
# 见 assets/ui_font/README.md 与 THIRD_PARTY.md。
/assets/ui_font/**
!/assets/ui_font/README.md

# 但保留两个目录下的说明文件，克隆者要靠它们知道该放什么
!/models/README.md
!/splatdata/README.md

