; 高斯泼溅校园：×25 放大（内容约 211 × 160 m），自动水平居中、顶面沉到平台下方 12 m。
; 数据是「俯拍航拍」，只有从上方看才干净 —— 所以做成悬浮平台 + 下沉校园。
; ⚠️ 显存：本份 615 万点，单独跑约占 2.9 GiB；和下面的画室609 同时加载时按
;    **点数之和** 分配（GDGS 把两块合并成一个 GPU 缓冲），要用 --venue=room 拆开。
[node name="SplatScene" type="Node3D" parent="."]
script = ExtResource("5_splat")
sog_path = "res://splatdata/school_playable.sogdata"
display_name = "校园"
venue = "campus"
world_scale = 25.0
auto_place = true
top_gap = 12.0

; 高斯泼溅「画室609」：第二块场地，摆在悬浮平台**中央**并放大到接近满场。
; 参数全部是量出来的（scripts/_probe_room_layout.gd + _probe_room_on_platform.gd），
; 不要手改：
;   world_scale = 6.4    内容源尺寸 5.63 × 1.95 × 6.41 → 世界 36.0 × 12.5 × 41.0 m，
;                        平台是 40 × 40 m，所以横向基本铺满（「接近满场」就是它）。
;                        想要真人比例的房间，把 6.4 改成 1.5~2 即可（椅子 2~3 m
;                        对 Arisu 1.4 m 是「巨人画室」，这是刻意的夸张）。
;   yaw_degrees = 248.6  **这一版把上一版记的 288.1 修正了**。上一版是拿
;                        scripts/_probe_room_layout.gd 打印的「主轴偏角 −18.10°」当
;                        「相对 +Z」，于是把 18.1 当成了对齐角。那个数是**相对 +X** 的
;                        （而且地板 4.87 × 5.40 源单位接近正方形，主轴本身就不稳定），
;                        所以上一版的四个候选角（18.1 / 108.1 / 198.1 / 288.1）其实
;                        **全都歪了 39.5°**。
;                        现在改用「墙直方图峰值集中度」扫出来的：房间最密的那对墙
;                        在 288.1 下要再转 −39.5° 才落到格子上，矫正后角谱在
;                        mod 90° 上严格重复（矩形特征），集中度 0.0188 → 0.0307。
;                        量法在 _verify_room.gd §3，自带一个「人为转 23°」的合成自检
;                        锁符号方向；换数据/换角度后重跑它，别凭感觉调。
;   anchor_*             地板在源坐标是 y = −0.333 的平面，地板中心
;                        (0.022, −0.333, −0.121)；把它对到平台地面 y = 0.03
;                        （留 3 cm 防 z-fighting）。auto_place 关掉，房间不能居中下沉。
;   crop_*               裁掉离群 floaters：本扫描 0.2% 的点是又大又远的椭球
;                        （单个尺度可达 15.13 源单位），放大 6.4 倍后就是糊满屏的
;                        **大白团**。分位盒外扩 0.5 + 丢尺度 > 0.5 的点，
;                        实测留 2,769,851 / 丢 4,265 点。
; ⚠️ 房间**没有碰撞**：墙可以穿过去（平台的 0.7 m 隐形护栏还在，走路掉不下去）。
;    「走到平台边缘低头看脚下的校园」会被房间地板挡住一部分 —— 想看校园就
;    --venue=campus，想只看房间就 --venue=room。
[node name="Room609" type="Node3D" parent="."]
script = ExtResource("5_splat")
sog_path = "res://splatdata/room609.sogdata"
display_name = "画室609"
venue = "room"
world_scale = 6.4
yaw_degrees = 248.6
auto_place = false
use_anchor = true
anchor_source = Vector3(0.022, -0.333, -0.121)
anchor_world = Vector3(0, 0.03, 0)
crop_enabled = true
crop_margin = 0.5
crop_max_scale = 0.5

; 霸王龙优香「木桩」：站在平台右侧、朝 -X 正对场地中心。
; 模型自身脸朝 +Z，所以绕 Y 转 -90° 就变成朝 -X。
; ⚠️ x 不能小于 13：x=9 时它的碰撞盒（约 7.8 m 长）会横在
;    「玩家(6,-4) → Target1(6,-10)」的弹道上，把每一发都吃掉。
; 默认身高 4.5 m（约 2.6 个 Arisu）、3000 血、受击闪白、倒下 6 秒后重生。
[node name="Boss" type="StaticBody3D" parent="."]
transform = Transform3D(0, 0, -1, 0, 1, 0, 1, 0, 0, 13, 0, -8)
script = ExtResource("6_boss")

; 飞猪优香「木桩」（作者：一个睿智）——第二个 Boss，与霸王龙同场。
; 与霸王龙的三点不同：
;   1. **纯静态网格**（无骨骼、无动画），所以 boss.gd 走 _mesh_box() 而不是 _bone_box()
;   2. 本体**朝 +Z**（实测鼻子 z=+2.17、尾巴 z=−1.95），不需要补 180°；
;      绕 Y 转 +90° 让它朝 +X（面向场地中心），与霸王龙的朝向习惯一致。
;   3. 贴图用 texture_map 显式绑（不依赖 Godot 对 FBX 相对路径的自动解析）
; 位置 x=−13 是为了**不挡**「玩家(6,−4) → Target1(6,−10)」那条自检弹道：
; 它长轴沿世界 X，占 x ∈ [−15.0, −11.0]、z ∈ [−9.2, −6.8]，离 x=6 很远。
; 默认身高 2.6 m（含光环）、1800 血、倒下 6 秒后重生。
[node name="BossPig" type="StaticBody3D" parent="."]
transform = Transform3D(0, 0, 1, 0, 1, 0, -1, 0, 0, -13, 0, -8)
