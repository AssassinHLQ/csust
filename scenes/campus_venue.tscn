[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/campus_stream.gd" id="1_splat"]

; 校园默认使用本项目修改版 godot-gsplat-stream。
; 流式包已经转换为校园碰撞使用的世界坐标，子节点保持单位变换。
; 默认 96 个区块预算；按当前相机逐步细化，不再一次上传完整扫描。
; 以下 SOG 摆放参数供 --campus-renderer=gdgs 回退时使用。
[node name="CampusVenue" type="Node3D"]
script = ExtResource("1_splat")
sog_path = "res://splatdata/school_playable.sogdata"
display_name = "校园"
venue = "campus"
world_scale = 75.0
auto_place = true
top_gap = 12.0
ignore_room_y_hi = true
