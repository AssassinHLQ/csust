[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/splat_scene.gd" id="1_splat"]

; 校园泼溅「独立场地」：从 game.tscn 里搬出来的（用户要求「先把学校去掉，
; 我以后放到别的场景」）。想用的时候把这个场景实例化进任何场景即可：
;
;   var campus := (load("res://scenes/campus_venue.tscn") as PackedScene).instantiate()
;   add_child(campus)
;
; 摆放参数是针对这份**俯拍航拍**扫描调的（README §6.4 / §6.5）：
;   world_scale = 25    内容约 211 × 160 m（真实校园尺度）
;   auto_place = true   水平自动居中 + 顶面沉到 top_gap 之下
;   top_gap = 12        内容是「只有从上方看才干净」的薄饼，所以要沉到平台下面
;                       —— 配一个悬浮平台、玩家低头俯视才好看。
;                       单独用这个场景时记得自己给它配平台/相机。
; ⚠️ 显存：615 万点，单独加载约占 2.9 GiB（RTX 4060 Laptop 8 GB 要留意）。
;    和画室609 同时加载时 GDGS 会把两块合并成一个 GPU 缓冲、按点数之和分配，
;    用 `-- --venue=campus` 可以只加载这一份。
[node name="CampusVenue" type="Node3D"]
script = ExtResource("1_splat")
sog_path = "res://splatdata/school_playable.sogdata"
display_name = "校园"
venue = "campus"
world_scale = 25.0
auto_place = true
top_gap = 12.0
