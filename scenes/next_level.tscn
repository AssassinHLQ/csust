; 校园：world_scale=75（2026-10-28 用户要求「放大三倍」），地面 576×484 m。
; 同时把量出来的 1.16°/0.43° 扫描倾角转平：basis ≈ Rx(1.163°)·Rz(0.429°)，
; y 让拟合地面落在 −0.02 附近；CampusCollision 的盒碰撞是从**同一变换**下的
; 点云烘出来的（scripts/_bake_campus_collision.gd），改这里之后要重烘。
[node name="Campus" parent="." instance=ExtResource("8_campus")]
transform = Transform3D(0.999972, -0.00749, 0, 0.007488, 0.999766, -0.020299, 0.000152, 0.020298, 0.999794, 0, 49.81, -316.7)
crop_enabled = true
crop_margin = 0.5
crop_max_scale = 0.5
start_delay = 8.0
start_distance = 0.0
low_priority = true
preload_on_gate = false

; 校园碰撞：campus_collision_walls_final.scn（2026-10-29 默认）
;   = collider-forge 的 Poisson 网格经 _tools/campus_collision_refine.py 三步处理：
;     ① 顶点沿局部平面投影贴到点云（中位偏差 0.378 → 0.322 m，平均挪 0.145 m）
;     ② 只留竖直面（|法线 y| ≤ 0.55、最高点 ≥ 1 m）—— 地面交给 CampusFloor 平板
;        （校园地面拟合倾角只有 0.18°/0.05°，是平的；网格自己的地面会让人浮空/陷进去）
;     ③ 剔掉重心离点云 > 0.75 m 的「凭空补面」23.1% —— 那些就是看不见的墙和鼓包
;   18.2 万三角 / 6.2 MB。实测：主路 45 个落点全部踩在 -0.02，主路 1 m 高被挡 0.4%。
; 备选（按需换 instance）：
;   campus_collision_mesh.scn  = 原始 Poisson 62.9 万面（会浮空/站在树冠上）
;   campus_collision_fine.tscn = 3 m 细盒子 1598 块（主路 34.4% 被挡，会卡死在盒子里）
;   campus_collision.tscn      = 12 m 粗盒子 25 块（只有 20 m 以上的楼，最省）
[node name="CampusCollision" parent="." instance=ExtResource("14_campusmesh_upper")]

