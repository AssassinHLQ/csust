; 校园：world_scale=75（2026-10-28 用户要求「放大三倍」），地面 576×484 m。
; 同时把量出来的 1.16°/0.43° 扫描倾角转平：basis ≈ Rx(1.163°)·Rz(0.429°)，
; y 让拟合地面落在 −0.02 附近；CampusCollision 的盒碰撞是从**同一变换**下的
; 点云烘出来的（scripts/_bake_campus_collision.gd），改这里之后要重烘。
[node name="Campus" parent="." instance=ExtResource("8_campus")]
transform = Transform3D(0.999972, -0.00749, 0, 0.007488, 0.999766, -0.020299, 0.000152, 0.020298, 0.999794, 0, 49.81, -316.7)
crop_enabled = true
crop_margin = 0.5
crop_max_scale = 0.5
start_delay = 8.0
start_distance = 0.0
low_priority = true
preload_on_gate = false

; 碰撞四套，按需换 instance（实测数字见 scripts/ 下对应烘焙脚本的文件头）：
;   campus_collision_mesh_upper.scn = **默认**：Poisson 网格剪掉「最高顶点不到 1 m」
;      的贴地三角形（10.6%），地面交回 CampusFloor 平板，墙/树照旧。
;   campus_collision_mesh.scn  = 原始 Poisson 网格 62.9 万面。网格自己的地面比点云
;      地面低 >0.3 m 的占 37.5%、高 >0.3 m 的占 28.8%，人会浮空/陷进去。
;   campus_collision_fine.tscn = 3 m 细盒子 1598 块。实测主路 34.4% 的采样点被盒子
;      挡住、有人直接卡在盒子里（on_floor=false），所以不用来当默认。
;   campus_collision.tscn      = 12 m 粗盒子 25 块（只有 20 m 以上的楼，最省）。
; 编辑器专用的低模点云预览（运行时自动隐藏），用来对齐碰撞。
