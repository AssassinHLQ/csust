## 供自检 / 文档生成用：所有登记过的路径。
static func all_paths() -> PackedStringArray:
	var out: PackedStringArray = []
	for e in ENTRIES:
		out.append(e["path"])
	return out


## 某条路径是否被登记（含「父目录已登记」的情况）。
static func covers(path: String) -> bool:
	var p := path.replace("\\", "/").trim_suffix("/")
	for e in ENTRIES:
		var q: String = e["path"].replace("\\", "/").trim_suffix("/")
		if p == q or p.begins_with(q + "/"):
			return true
	return false


static func entry_for(path: String) -> Dictionary:
	var p := path.replace("\\", "/").trim_suffix("/")
	for e in ENTRIES:
		if e["path"].replace("\\", "/").trim_suffix("/") == p:
			return e
	return {}


## 游戏内「致谢」面板用的纯文本（按 GROUPS 分组）。
static func plain_text() -> String:
	var out: PackedStringArray = []
	out.append("素材署名按作者与平台记录；以下顺序先致谢 Kenney，再致谢 Cup Nooble。")
	out.append("本项目自有代码以 MIT 授权；第三方素材与原工程代码分别适用各自条款。")
	out.append("Git 跟踪状态与游戏导出包含规则分开；本清单不用于排除打包素材。")
	out.append("")
	for g in GROUPS:
		out.append("【%s】" % g)
		for e in ENTRIES:
			if e["group"] != g:
				continue
			out.append("· %s" % e["title"])
			out.append("    作者：%s" % e["author"])
			if e["platform"] != "":
				out.append("    平台：%s" % e["platform"])
			out.append("    许可：%s" % e["license"])
			if e["source"] != "":
				out.append("    来源：%s" % e["source"])
			out.append("    位置：%s%s" % [
				e["path"], "" if e["distributed"] else "（Git 忽略本体；导出另按配置）"])
			if e["note"] != "":
				out.append("    备注：%s" % e["note"])
		out.append("")
	out.append("完整表格见仓库根目录 CREDITS.md / THIRD_PARTY.md。")
	return "\n".join(out)
